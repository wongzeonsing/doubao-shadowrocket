#!name=豆包去水印（实验 v2）
#!desc=把豆包接口里的 image_ori（带水印）替换为 image_ori_raw（无水印原图）。仅网页版生效，App 内无效。⚠️ 未真机验证，异常请关闭本模块。
#!author=Minis
#!category=应用增强
#!system=ios
#!homepage=https://github.com/wongzeonsing/doubao-shadowrocket

[Rule]
# 禁用 QUIC，否则流量走 HTTP/3 会绕过 HTTPS 解密，脚本不触发
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN,www.doubao.com)),REJECT

[Script]
doubao-nomark = type=http-response,pattern=^https:\/\/www\.doubao\.com\/(im\/chain\/|samantha\/|creativity\/resource\/),requires-body=1,max-size=5242880,engine=webview,script-path=https://raw.githubusercontent.com/wongzeonsing/doubao-shadowrocket/main/doubao-nomark.js,timeout=30

[MITM]
hostname = %APPEND% www.doubao.com
